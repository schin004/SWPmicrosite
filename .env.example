# ── GreenPass configuration ──────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.

# Backend database connection (PostgreSQL / Neon).
# On Rabbit Deploy this is set automatically when you create/attach a database.
# Locally you can point it at any Postgres instance.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Set to "disable" ONLY for a local Postgres without SSL. Leave unset for Neon.
# PGSSL=disable

# Claude API key — powers AI content moderation of new-hire introductions.
# Get one at https://console.anthropic.com/. If left unset, submissions are
# still accepted and simply marked for manual HR review.
ANTHROPIC_API_KEY=

# Shared HR admin password for the /admin dashboard (default: nparks-admin).
ADMIN_PASSWORD=nparks-admin

# Set to "1" to seed 3 demo submissions on startup when the database is empty.
# SEED_DEMO=1

# Port for the server (default: 3000). On Rabbit this is provided automatically.
# PORT=3000
