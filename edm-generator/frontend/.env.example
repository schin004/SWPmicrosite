# Optional: absolute base URL for the backend API.
# Leave blank to use relative /api URLs (proxied by the Vite dev server).
# In production set this to your deployed backend, e.g. https://edm.example.gov.sg
VITE_API_BASE=

# Optional: override the dev-server proxy target (defaults to http://localhost:8000)
VITE_API_TARGET=http://localhost:8000
