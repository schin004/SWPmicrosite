# ---------------------------------------------------------------------------
# NParks eDM Generator (Node/Neon) — environment configuration
#
# On Rabbit Deploy, DATABASE_URL is set automatically when you create/attach a
# Neon database. Everything else is optional and has sensible defaults.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string (set automatically by Rabbit Deploy).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Set to "disable" ONLY for a local Postgres without SSL. Leave unset for Neon.
# PGSSL=disable

# Port (Rabbit provides PORT automatically; defaults to 3000 locally).
# PORT=3000

# Careers@Gov source
CAREERS_AGENCY=National Parks Board
CAREERS_BASE_URL=https://www.careers.gov.sg
# REQUIRED to sweep LIVE data. The real Careers@Gov listings API (an OData JSON
# service on the "HRP" platform) is not publicly published, so you must supply
# its URL here. The parser understands the real HRP fields (Jobtitle, Agncy,
# Endda, Jobdesc) and OData envelopes. Leave blank to run on the bundled sample
# dataset instead.
CAREERS_SEARCH_URL=
REQUEST_TIMEOUT_MS=20000
MAX_VACANCIES=60
# When live retrieval fails or no endpoint is set, fall back to the bundled
# sample dataset so the tool is always demonstrable. Set false to surface an
# error instead.
USE_SAMPLE_FALLBACK=true

# Optional AI summaries via Claude. Leave blank to use the local extractive
# fallback (no external calls, still faithful to the source).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
SUMMARY_MIN_WORDS=25
SUMMARY_MAX_WORDS=40
