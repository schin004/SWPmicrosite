# ---------------------------------------------------------------------------
# NParks eDM Generator — backend configuration
# Copy to `.env` and adjust as needed. All values have sensible defaults.
# ---------------------------------------------------------------------------

# General
LOG_LEVEL=INFO

# Persistence (any SQLAlchemy URL; default is a local SQLite file)
DATABASE_URL=sqlite:///./edm.db

# Careers@Gov source
CAREERS_BASE_URL=https://www.careers.gov.sg
CAREERS_AGENCY=National Parks Board
# Best-effort JSON search endpoint (portal contract is not guaranteed/stable)
CAREERS_SEARCH_URL=https://www.careers.gov.sg/api/v2/jobs/search
REQUEST_TIMEOUT=20
MAX_VACANCIES=60
# When live retrieval fails, fall back to the bundled sample dataset
USE_SAMPLE_FALLBACK=true

# Optional scheduled auto-refresh (off by default; refresh is on demand)
AUTO_REFRESH_ENABLED=false
# One of: hourly | daily | weekly
AUTO_REFRESH_INTERVAL=daily

# Optional AI summaries via Claude. Leave blank to use the deterministic
# extractive fallback (no external calls, still faithful to the source).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
SUMMARY_MIN_WORDS=25
SUMMARY_MAX_WORDS=40

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
